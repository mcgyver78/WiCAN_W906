  {
    "id": "w906_dtc_evaluate",
    "type": "function",
    "z": "w906_dtc_flow_tab",
    "name": "Ergebnis auswerten",
    "func": "const p = msg.payload || {};\nconst action = p.action === 'clear' ? 'Löschen' : 'Lesen';\nif (p.state === 'running') {\n    return [{ payload: action + ' läuft … ' + (p.ecu || 0) + '/' + (p.total || '?') }, null, null];\n}\nif (p.state === 'error') {\n    const reason = p.reason === 'ecu_offline' ? 'keine Antwort – Zündung einschalten' : (p.reason || 'Fehler');\n    return [{ payload: action + ': ' + reason }, null, null];\n}\nif (p.state !== 'done' || !Array.isArray(p.ecus)) return null;\nconst rows = [];\nlet silent = 0;\nfor (const ecu of p.ecus) {\n    for (const dtc of ecu.dtcs || []) {\n        rows.push({ ecu: ecu.name, code: dtc.code, status: (dtc.active ? 'aktiv' : 'gespeichert') + ' (0x' + dtc.status + ')' });\n    }\n    if (ecu.status !== 'ok') {\n        silent++;\n        rows.push({ ecu: ecu.name, code: '–', status: ecu.status === 'no_response' ? 'keine Antwort' : ecu.status });\n    }\n}\nconst count = p.dtc_count || 0;\nconst when = new Date().toLocaleString('de-DE');\nconst summary = count === 0 ? 'keine Fehler gespeichert' : count + (count === 1 ? ' Fehler' : ' Fehler') + ' gespeichert';\nreturn [{ payload: action + ' fertig (' + Math.round((p.duration_ms || 0) / 1000) + ' s)' },\n        { payload: summary + (silent ? ', ' + silent + ' Steuergerät(e) ohne Antwort' : '') + ' – ' + when },\n        { payload: rows }];",
    "outputs": 3,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 380,
    "y": 300,
    "wires": [
      [
        "w906_dtc_ui_state"
      ],
      [
        "w906_dtc_ui_summary"
      ],
      [
        "w906_dtc_ui_table"
      ]
    ]
  },
