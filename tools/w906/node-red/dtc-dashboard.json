    "type": "mqtt in",
    "z": "w906_dtc_flow_tab",
    "name": "Fehlerspeicher",
    "topic": "wican/sprinter/engine/dtc",
    "qos": "0",
    "datatype": "json",
    "broker": "w906_mqtt_broker",
    "nl": false,
    "rap": true,
    "rh": 0,
    "inputs": 0,
