    "id": "w906_dtc_remember",
    "type": "function",
    "z": "w906_dtc_flow_tab",
    "name": "WiCAN merken",
    "func": "const id = msg.topic.split('/')[1];\nflow.set('wican_id', id);\nmsg.payload = id + ' (' + ((msg.payload && msg.payload.status) || '?') + ')';\nreturn msg;",
