    "func": "// The WiCAN sends {\"ecu\":\"offline\"} instead of stale values while the vehicle is asleep\nconst meta = {\"ENGINE_RPM\": {\"kind\": \"gauge\", \"unit\": \"1/min\", \"digits\": 1}, \"ACCEL_PEDAL\": {\"kind\": \"gauge\", \"unit\": \"%\", \"digits\": 1}, \"COOLANT_TMP\": {\"kind\": \"gauge\", \"unit\": \"°C\", \"digits\": 1}, \"ENGINE_OIL_TEMP\": {\"kind\": \"gauge\", \"unit\": \"°C\", \"digits\": 1}, \"OIL_LEVEL\": {\"kind\": \"text\", \"unit\": \"mm\", \"digits\": 0}, \"ECU_DISTANCE\": {\"kind\": \"text\", \"unit\": \"km\", \"digits\": 0}, \"RAIL_PRESSURE\": {\"kind\": \"gauge\", \"unit\": \"bar\", \"digits\": 1}, \"INJECTION_QUANTITY\": {\"kind\": \"text\", \"unit\": \"mg\", \"digits\": 1}, \"FUEL_L\": {\"kind\": \"text\", \"unit\": \"L\", \"digits\": 0}, \"FUEL_TEMP\": {\"kind\": \"text\", \"unit\": \"°C\", \"digits\": 1}, \"BOOST_PRESSURE\": {\"kind\": \"gauge\", \"unit\": \"hPa\", \"digits\": 1}, \"BOOST_PRESSURE_LP\": {\"kind\": \"text\", \"unit\": \"hPa\", \"digits\": 0}, \"AIR_MASS_PER_STROKE\": {\"kind\": \"text\", \"unit\": \"mg/Hub\", \"digits\": 0}, \"EGR_RATE\": {\"kind\": \"text\", \"unit\": \"%\", \"digits\": 1}, \"WASTEGATE\": {\"kind\": \"text\", \"unit\": \"%\", \"digits\": 1}, \"INTAKE_AIR_TMP\": {\"kind\": \"text\", \"unit\": \"°C\", \"digits\": 1}, \"INTAKE_AIR_PRESSURE\": {\"kind\": \"text\", \"unit\": \"hPa\", \"digits\": 0}, \"BARO_PRESSURE\": {\"kind\": \"text\", \"unit\": \"hPa\", \"digits\": 0}, \"CHARGE_AIR_TEMP_PRE_IC\": {\"kind\": \"text\", \"unit\": \"°C\", \"digits\": 1}, \"CHARGE_AIR_TEMP_POST_IC\": {\"kind\": \"text\", \"unit\": \"°C\", \"digits\": 1}, \"EGT_PRE_TURBO\": {\"kind\": \"gauge\", \"unit\": \"°C\", \"digits\": 1}, \"EGT_PRE_CAT\": {\"kind\": \"gauge\", \"unit\": \"°C\", \"digits\": 1}, \"EGT_PRE_DPF\": {\"kind\": \"gauge\", \"unit\": \"°C\", \"digits\": 1}, \"EGT_PRE_SCR\": {\"kind\": \"gauge\", \"unit\": \"°C\", \"digits\": 1}, \"EXHAUST_BACK_PRESSURE\": {\"kind\": \"gauge\", \"unit\": \"hPa\", \"digits\": 1}, \"DPF_DIFF_PRESSURE\": {\"kind\": \"gauge\", \"unit\": \"hPa\", \"digits\": 1}, \"EGT_POST_EGR_COOLER\": {\"kind\": \"text\", \"unit\": \"°C\", \"digits\": 1}, \"LAMBDA\": {\"kind\": \"text\", \"unit\": \"\", \"digits\": 2}};\nconst keys = [\"ENGINE_RPM\", \"ACCEL_PEDAL\", \"COOLANT_TMP\", \"ENGINE_OIL_TEMP\", \"OIL_LEVEL\", \"ECU_DISTANCE\", \"RAIL_PRESSURE\", \"INJECTION_QUANTITY\", \"FUEL_L\", \"FUEL_TEMP\", \"BOOST_PRESSURE\", \"BOOST_PRESSURE_LP\", \"AIR_MASS_PER_STROKE\", \"EGR_RATE\", \"WASTEGATE\", \"INTAKE_AIR_TMP\", \"INTAKE_AIR_PRESSURE\", \"BARO_PRESSURE\", \"CHARGE_AIR_TEMP_PRE_IC\", \"CHARGE_AIR_TEMP_POST_IC\", \"EGT_PRE_TURBO\", \"EGT_PRE_CAT\", \"EGT_PRE_DPF\", \"EGT_PRE_SCR\", \"EXHAUST_BACK_PRESSURE\", \"DPF_DIFF_PRESSURE\", \"EGT_POST_EGR_COOLER\", \"LAMBDA\"];\nconst p = msg.payload || {};\nconst offline = p.ecu === 'offline';\nconst out = keys.map(k => {\n    const m = meta[k];\n    if (offline) return { topic: k, payload: m.kind === 'gauge' ? 0 : '–' };\n    if (typeof p[k] !== 'number') return null;\n    if (m.kind === 'gauge') return { topic: k, payload: p[k] };\n    return { topic: k, payload: (p[k].toFixed(m.digits) + ' ' + m.unit).trim() };\n});\nout.push({ payload: offline ? 'schläft (IGN aus)' : 'aktiv' });\nreturn out;",
